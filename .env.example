# Copy this file to .env and fill in real values. Never commit .env.

# Database (SQLite by default; leave unset for local-first operation)
JOBINTEL_DATABASE_URL=sqlite:///data/jobintel.db

# LLM provider for structured job evaluation (Milestone 4 evaluators).
# The app runs without this key: no evaluator falls back to a mock or a
# fabricated result - it simply skips LLM-stage evaluation and jobs stay
# at the semantic-pre-score stage until a key is configured.
ANTHROPIC_API_KEY=

# Optional: model id override for the Anthropic evaluator.
JOBINTEL_LLM_MODEL=claude-sonnet-5

# Optional daily LLM spend cap in USD (overrides config/scoring.yaml).
JOBINTEL_DAILY_LLM_BUDGET_USD=5.00

# Optional future notification adapters - unset means disabled.
JOBINTEL_TELEGRAM_BOT_TOKEN=
JOBINTEL_TELEGRAM_CHAT_ID=
JOBINTEL_SLACK_WEBHOOK_URL=
JOBINTEL_SMTP_HOST=
JOBINTEL_SMTP_USER=
JOBINTEL_SMTP_PASSWORD=

# HTTP collection behaviour
JOBINTEL_REQUEST_TIMEOUT_SECONDS=20
JOBINTEL_USER_AGENT="RemoteJobIntelligence/0.1 (personal use; contact: bestrichardanthonyspencer@gmail.com)"
